# Story Studio 本地配置（复制为 .env 后填写；.env 已被 gitignore，绝不提交）

# OpenAI 兼容端点（DeepSeek / Kimi / Qwen / GLM / 各类网关均可）
STORY_STUDIO_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
STORY_STUDIO_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型 ID（按端点支持的模型填写；deepseek-v4 系列上下文 1M tokens，故事创作建议 v4-flash/v4-pro）
STORY_STUDIO_MODEL_ID=deepseek-v4-pro

# 输入栏可选模型（逗号分隔；第一个为默认。缺省：deepseek-v4-flash,deepseek-v4-pro,deepseek-reasoner）
STORY_STUDIO_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-reasoner

# 书工作区（唯一真相源，目录结构与 oh-story 兼容）。
# 留空 = 默认项目根目录；强烈建议复制本文件为 .env 后，把这里改成你自己的书目录，
# 或直接忽略，启动后经欢迎页「打开小说文件夹 / 新建小说」选择书目录（运行时生效，不写回 .env）
STORY_STUDIO_WORKSPACE=

# 服务端口（只绑 127.0.0.1）
STORY_STUDIO_PORT=8100

# 启动后自动打开浏览器（欢迎页先选择创作目录再进入）；false 关闭，可手动访问 http://127.0.0.1:8100
STORY_STUDIO_AUTO_OPEN=true
